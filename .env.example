# Riot Games Developer API Key (https://developer.riotgames.com)
RIOT_API_KEY=RGAPI-your-key-here
RIOT_DEFAULT_REGION=br1
RIOT_APP_ID=364635

REDIS_PASSWORD=league_persua_redis_dev

# npm run / prisma no host — Postgres compartilhado do servidor
DATABASE_URL=postgresql://postgres:SENHA@127.0.0.1:5432/league_persua?schema=public
REDIS_URL=redis://:league_persua_redis_dev@127.0.0.1:6380

# App no Docker (rede servicos + Redis deste compose)
DATABASE_URL_DOCKER=postgresql://postgres:SENHA@postgres:5432/league_persua?schema=public
REDIS_URL_DOCKER=redis://:league_persua_redis_dev@redis:6379

# Postgres local (profile local-db, porta 5436) — opcional para notebook:
# DATABASE_URL=postgresql://league_persua:league_persua_dev@127.0.0.1:5436/league_persua?schema=public

# Token do bridge Live Client Data (PC de jogo → servidor). Gere um segredo forte.
# LIVE_AGENT_TOKEN=troque-por-um-segredo-forte
