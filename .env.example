# Riot Games Developer API Key (https://developer.riotgames.com)
# Never expose this key to the browser — used only by Next.js API routes.
RIOT_API_KEY=RGAPI-your-key-here
RIOT_DEFAULT_REGION=br1
# Reference only (App ID 364635): 20 req/1s · 100 req/2min
RIOT_APP_ID=364635

# Postgres — local Compose (profile local-db, host port 5436)
DATABASE_URL=postgresql://league_persua:league_persua_dev@127.0.0.1:5436/league_persua?schema=public

# Postgres — servidor compartilhado (após criar-servico.sh league_persua)
# DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/league_persua?schema=public
# Docker na rede "servicos":
# DATABASE_URL=postgresql://USER:PASS@postgres:5432/league_persua?schema=public

# Redis — local Compose (host port 6380; altere se a porta estiver ocupada)
REDIS_URL=redis://:league_persua_redis_dev@127.0.0.1:6380
REDIS_PASSWORD=league_persua_redis_dev
